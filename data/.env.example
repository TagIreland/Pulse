# Copy this to .env and fill it in. .env is in .gitignore — keep it that way.

# Supabase: Project settings -> Database -> Connection string -> URI.
# Use the connection pooler host rather than the direct one.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Firebase: Project settings -> Service accounts -> Generate new private key.
# Save the JSON file OUTSIDE this repository and point at it here.
FIREBASE_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
FIREBASE_COLLECTION=predictions
